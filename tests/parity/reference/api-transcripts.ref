# Safe, independently recorded/derived MCPI transcript vectors.
# Multi-command inputs use | only inside this test fixture; | is not part of MCPI syntax.
reference_build=mcpi-0.1.1
subsystem=api-transcript
name=malformed-getblock
input=world.getBlock(1,2)
expected=fail
---
reference_build=mcpi-0.1.1
subsystem=api-transcript
name=float-format
input=player.setPos(-1.25,2.5,3.125)|player.getPos()
expected=response:-1.25,2.5,3.125
---
reference_build=mcpi-0.1.1
subsystem=api-transcript
name=negative-floor
input=player.setPos(-0.1,0,0)|player.getTile()
expected=response:-1,0,0
---
reference_build=mcpi-0.1.1
subsystem=api-transcript
name=spawn-offset
input=player.setPos(1,2,3)|player.getPos()
expected=response:1,2,3
---
reference_build=mcpi-0.1.1
subsystem=api-transcript
name=setblocks-clamp
input=world.setBlocks(-1,-1,-1,1,1,1,1)|world.getBlock(0,0,0)
expected=response:1
---
reference_build=mcpi-0.1.1
subsystem=api-transcript
name=chat-comma
input=chat.post(Hello,Pi)
expected=no-response
---
reference_build=mcpi-0.1.1
subsystem=api-transcript
name=camera-setpos
input=camera.setPos(1,2,3)
expected=no-response
---
reference_build=mcpi-0.1.1
subsystem=api-transcript
name=events-empty
input=events.block.hits()
expected=response:
---
reference_build=mcpi-0.1.1
subsystem=api-transcript
name=entity-missing
input=entity.getPos(999)
expected=fail
---
reference_build=mcpi-0.1.1
subsystem=api-transcript
name=entity-local
input=entity.setPos(0,4,5,6)|entity.getPos(0)
expected=response:4,5,6
---
reference_build=mcpi-0.1.1
subsystem=api-transcript
name=unknown-command
input=unknown.command()
expected=no-response
---
